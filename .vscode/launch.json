{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SDL2, Local",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/blaise-debug",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "Build SDL2, Local",
            "externalConsole": false,
            "pipeTransport": {
                "pipeProgram": "python3",
                "pipeArgs": [
                    "${workspaceFolder}/scripts/debug/linux.py",
                    "linux-sdl2"
                ],
                "debuggerPath": "/usr/bin/gdb",
                "pipeCwd": "${workspaceFolder}"
            }
        },
