        {
            "name": "GEM, Rasta",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/platforms/linux-gemix-gemd/debug/bin/blaise",
            "setupCommands": [
                {
                    "description": "Pass mailbox identifiers beginning with # literally",
                    "text": "set startup-with-shell off",
                    "ignoreFailures": false
                }
            ],
            "args": [
                "--config",
                "${workspaceFolder}/build/uat-mail/config",
                "--mail",
                "${workspaceFolder}/build/uat-mail/Mail",
                "--select",
                "#mh/Mailbox/inbox"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "preLaunchTask": "Build GEM, Rasta",
            "externalConsole": false,
            "pipeTransport": {
                "pipeProgram": "python3",
                "pipeArgs": [
                    "${workspaceFolder}/scripts/debug/linux.py",
                    "linux-gemix-gemd",
                    "--demo-mail"
                ],
                "debuggerPath": "/usr/bin/gdb",
                "pipeCwd": "${workspaceFolder}"
            }
        },
        {
            "name": "Haiku, VM",
            "type": "cppdbg",
            "request": "launch",
            "program": "/boot/home/Projects/blaise/blaise",
            "args": [],
            "cwd": "/boot/home/Projects/blaise",
            "MIMode": "gdb",
            "preLaunchTask": "Deploy Haiku, VM",
            "externalConsole": false,
            "pipeTransport": {
                "pipeProgram": "python3",
                "pipeArgs": [
                    "${workspaceFolder}/scripts/debug/remote.py",
                    "debug-haiku"
                ],
                "debuggerPath": "/boot/system/bin/gdb"
            }
        }
    ]
